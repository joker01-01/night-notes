# 此文件仅作示例；复制为 .env 后填写。设置页中的值会保存在本地 SQLite。
AI_REVIEW_DATABASE_URL=sqlite:///./data/ai_daily_review.db
AI_REVIEW_LLM_PROVIDER=deepseek
AI_REVIEW_LLM_API_KEY=
AI_REVIEW_LLM_BASE_URL=https://api.deepseek.com
# DeepSeek V4 高能力版本；如偏好速度与成本可改为 deepseek-v4-flash。
AI_REVIEW_LLM_MODEL=deepseek-v4-pro
AI_REVIEW_QUESTION_TIME=21:00
AI_REVIEW_CONTEXT_DAYS=7
